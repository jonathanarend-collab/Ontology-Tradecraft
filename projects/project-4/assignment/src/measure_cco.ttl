@prefix bfo: <http://purl.obolibrary.org/obo/bfo.owl#> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix ex: <http://example.org/project4/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Project4MeasurementOntology a owl:Ontology ;
    rdfs:label "Project 4 Measurement Ontology"@en .

ex:artifact_Boiler-07 a cco:Artifact ;
    rdfs:label "Boiler-07"@en ;
    bfo:bearer_of ex:sdc_Boiler-07_pressure,
        ex:sdc_Boiler-07_temperature .

